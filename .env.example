# Copy this file to .env.local and fill in what you need, then restart the app.

# --- AI ----------------------------------------------------------------------
# Building from a prompt, an image, a brand or a Figma frame, and the chat in
# the editor, all need an AI key. Cloning, code editing, export and publish
# work without one.

# Google Gemini (used when set). Create a key in Google AI Studio.
GEMINI_API_KEY=

# Optional. Gemini models to use, in order of preference. When one is rate
# limited or busy the next takes over. Free keys can only use Flash models.
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash

# Optional. Requests per minute each Gemini model allows for your key.
# Free keys allow 5; raise this if your plan allows more.
# GEMINI_RPM=5

# Alternative: the Claude API, or a service that speaks the same protocol.
# Used when no Gemini key is set, or when CLONER_AI_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=
# CLONER_AI_MODEL=claude-opus-5-5
# For a compatible service, its address without "/v1":
# ANTHROPIC_BASE_URL=

# Optional. Set to off when the AI service does not pass images to the model.
# CLONER_AI_IMAGES=off

# Optional. Force one provider when keys for both are present: gemini or anthropic.
# CLONER_AI_PROVIDER=

# Optional. A second provider (gemini or anthropic) that takes over when the main one
# can't finish a request. Requests with images go first to the one that can read them.
# CLONER_AI_FALLBACK=

# --- Figma -------------------------------------------------------------------
# "Import Figma" needs a Figma personal access token with read access to the
# file (Figma > Settings > Security > Personal access tokens).
# FIGMA_TOKEN=

# --- Storage and network -----------------------------------------------------
# Optional. Where projects are stored. Defaults to .clones in the project folder.
# CLONER_DATA_DIR=

# Optional. Set to 1 to allow cloning sites on localhost or a private network.
# Leave unset anywhere other people can reach the app.
# CLONER_ALLOW_PRIVATE_HOSTS=1

# Optional. The browser that loads pages before they are copied. Chrome or Edge is
# found automatically; give a path to use another Chromium browser, or "off" to
# copy pages as the server sends them.
# CLONER_BROWSER=off
